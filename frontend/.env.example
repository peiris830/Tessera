# Frontend configuration: the variable names the app needs (see src/config.ts).
# Don't fill this in by hand: run scripts/frontend-env.ps1, which reads the real values from
# SSM Parameter Store and writes them to .env.local (gitignored).
# None of these are secrets (they end up in the public JavaScript bundle), but they are
# specific to one AWS deployment, so they aren't committed.

# Catalogue API base URL (SSM /tessera/<env>/catalogue/api-url)
VITE_CATALOGUE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
# Cognito token issuer (SSM /tessera/<env>/cognito/issuer-url)
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# Cognito app client ID (SSM /tessera/<env>/cognito/app-client-id)
VITE_COGNITO_CLIENT_ID=<app-client-id>
# Cognito hosted login page (SSM /tessera/<env>/cognito/hosted-ui-url)
VITE_COGNITO_HOSTED_UI_URL=https://tessera-<env>-<suffix>.auth.<region>.amazoncognito.com
